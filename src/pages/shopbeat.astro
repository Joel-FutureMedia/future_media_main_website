---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Shopbeat demo – FutureMedia" fonts="text">
<main class="sub live-page">
  <div class="live-hero">
    <p class="eyebrow">Shopbeat</p>
    <h1>Request a demo</h1>
    <p>Tell us the feeling you want in-store and we’ll shape a sound world around it.</p>
  </div>
  <form class="live-form" id="shopbeatForm" style="max-width:640px">
    <label>Name<input name="name" required></label>
    <label>Email<input name="email" type="email" required></label>
    <label>Telephone<input name="telephone" required></label>
    <label>Company<input name="company" required></label>
    <label>Feeling<select name="feelingId" required><option value="">Loading…</option></select></label>
    <label>Do you have sound inspiration?
      <select name="hasSoundInspiration" required>
        <option value="false">No</option>
        <option value="true">Yes</option>
      </select>
    </label>
    <label>Inspiration details<textarea name="soundInspiration" rows="3"></textarea></label>
    <label>Message<textarea name="message" rows="4" required></textarea></label>
    <button type="submit">Request demo</button>
    <p class="note" id="shopbeatNote" hidden></p>
  </form>
</main>
</Layout>
