---
import Layout from '../layouts/Layout.astro';
const root = "/assets/Broadcast%20Brands";
const logos = [
  ["/assets/Brandlogos/99fm.webp", "99FM"],
  ["/assets/Brandlogos/freshfm.webp", "Fresh FM"],
  ["/assets/Brandlogos/novafm.webp", "Nova FM"],
  ["/assets/Brandlogos/omulungar.webp", "Omulunga Radio"],
  ["/assets/Brandlogos/oneafrica.webp", "One Africa"],
  ["/assets/Brandlogos/radiowave.webp", "Radio Wave"]
];
const offer = (logo, rows) => rows.map(row => [row[0], row[1], "/contact.html", logo, "contain"]);
const brands = [
  {
    id: "oneafrica", color: "#f15024", name: "One Africa", logo: "/assets/Brandlogos/oneafrica.webp",
    bg: `${root}/One%20Africa/FM_Brands_One_BG.jpg`,
    person: `${root}/One%20Africa/FM_Brands_One_Personality.png`,
    map: `${root}/One%20Africa/FM_Brands_One_Map.svg`,
    copy: "One Africa Television brings Namibians news, drama, sport and entertainment on DStv and local free-to-air platforms. Stories told in a voice audiences recognise as their own.",
    f: 46, m: 54, lsm: "6 - 10",
    offers: offer("/assets/Brandlogos/oneafrica.webp", [["Prime Time Spots", "Be seen during the evening news."], ["Sponsor a Show", "Own a weekly programme slot."], ["Sports Bundle", "Live match sponsorship package."]])
  },
  {
    id: "99fm", color: "#e30a7f", name: "99FM", logo: "/assets/Brandlogos/99fm.webp",
    bg: `${root}/99FM/FM_Brands_99_BG.png`,
    person: `${root}/99FM/FM_Brands_99_Personality.png`,
    map: `${root}/99FM/FM_Brands_99_Map.svg`,
    copy: "99FM reaches people driven by economic, social, and personal advancement, with uplifting talk and Hip-Hop, Afro, and RnB.",
    f: 48, m: 52, lsm: "7 - 10",
    offers: offer("/assets/Brandlogos/99fm.webp", [["Dolar Set", "Drive-time ad packages."], ["Amat Gorum", "Conversation Café sponsorship."], ["Tes Tolut Kim", "Live-read host mentions."]])
  },
  {
    id: "nova", color: "#1e8dc5", name: "Nova FM", logo: "/assets/Brandlogos/novafm.webp",
    bg: `${root}/Nova/FM_Brands_Noova_BG.jpeg`,
    person: `${root}/Nova/FM_Brands_Nova_Personality.png`,
    map: `${root}/Nova/FM_Brands_Nova_Map.svg`,
    copy: "Nova FM is pop, R&B and lifestyle talk for young professionals. A strong home for fashion, finance, tech and entertainment brands.",
    f: 55, m: 45, lsm: "6 - 10",
    offers: offer("/assets/Brandlogos/novafm.webp", [["Morning Show", "Own the daily wake-up call."], ["Weekend Mix", "Presenting sponsor slots."], ["Digital Boost", "Social and stream bundles."]])
  },
  {
    id: "fresh", color: "#ee3030", name: "Fresh FM", logo: "/assets/Brandlogos/freshfm.webp",
    bg: `${root}/Fresh/FM_Brands_Fresh_BG.jpeg`,
    person: `${root}/Fresh/FM_Brands_Fresh_Personality.png`,
    map: `${root}/Fresh/FM_Brands_Fresh_Map.svg`,
    copy: "Fresh FM plays the biggest hits, Afro house and party energy for a young, social audience. Built for beverages, retail, mobile and events.",
    f: 45, m: 55, lsm: "5 - 9",
    offers: offer("/assets/Brandlogos/freshfm.webp", [["Friday Fresh", "Weekend kick-off takeover."], ["Campus Tour", "Activation at universities."], ["Hit Countdown", "Sponsor the weekly chart."]])
  },
  {
    id: "omulunga", color: "#0c6633", name: "Omulunga Radio", logo: "/assets/Brandlogos/omulungar.webp",
    bg: `${root}/Omulunga/FM_Brands_Omulunga_BG.jpeg`,
    person: `${root}/Omulunga/FM_Brands_Omulunga_Personality.png`,
    map: `${root}/Omulunga/FM_Brands_Omulunga_Map.svg`,
    copy: "Omulunga Radio broadcasts in Oshiwambo, connecting families across the northern regions with local music, community news and cultural stories.",
    f: 51, m: 49, lsm: "4 - 8",
    offers: offer("/assets/Brandlogos/omulungar.webp", [["Community News", "Sponsor the daily bulletin."], ["Gospel Sunday", "Family-focused slots."], ["Market Day", "Retail promotion packages."]])
  },
  {
    id: "radiowave", color: "#143443", name: "Radio Wave", logo: "/assets/Brandlogos/radiowave.webp",
    bg: `${root}/Radiowave/FM_Brands_Wave_BG.jpeg`,
    person: `${root}/Radiowave/FM_Brands_Wave_Personality.png`,
    map: `${root}/Radiowave/FM_Brands_Wave_Map.svg`,
    copy: "Radio Wave plays classic and contemporary favourites for working adults and decision makers through the workday.",
    f: 49, m: 51, lsm: "7 - 10",
    offers: offer("/assets/Brandlogos/radiowave.webp", [["Workday Drive", "Sponsor the 9 to 5 playlist."], ["Business Hour", "Thought leadership segment."], ["Classic Weekend", "Premium lifestyle slots."]])
  }
];
---
<Layout title="Broadcast Brands – FutureMedia" fonts="display" bodyClass="brands" preload={`${root}/One%20Africa/FM_Brands_One_BG.jpg`}>
<div class="branddeck" style="--n:7">
<div class="brandstage">
<section class="slide bintro on" id="network">
  <div class="bgimg" style="background-image:url(/assets/landingpage_image.webp)"></div>
  <div class="introcopy">
    <p class="eyebrow">The network</p>
    <h1>Six Broadcast brands. One powerful network.</h1>
    <p>Scroll to move from one brand to the next. Each station fills the screen on its own.</p>
  </div>
  <div class="orbit" aria-hidden="true">
    <img class="orbit-core" src={`${root}/logo-cirlce.png`} alt="">
    <div class="orbit-spin">
      {logos.map(([src, name], i) => <span style={`--i:${i}`}><img src={src} alt={name}></span>)}
    </div>
  </div>
</section>

{brands.map(brand => (
<section class="slide brand" id={brand.id} style={`--c:${brand.color}`}>
  <div class="bgimg" style={`background-image:url('${brand.bg}')`}></div>
  <img class="personality" src={brand.person} alt="">
  <div class="bwrap">
    <div class="bmain">
      <img class="blogo" decoding="async" src={brand.logo} alt={brand.name}>
      <p>{brand.copy}</p>
      <div class="bstats">
        <div class="stat"><img class="bmap" src={brand.map} alt={`${brand.name} coverage`}><small>Reach</small></div>
        <div class="stat"><div class="gender" data-f={brand.f} data-m={brand.m}></div></div>
        <div class="stat"><span class="lsm">{brand.lsm}</span><small>LSM</small></div>
      </div>
    </div>
    <div class="panel" data-offers={JSON.stringify(brand.offers)}><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
  </div>
</section>
))}
</div>
</div>
<nav class="rail" aria-label="Brands">
  {brands.map(brand => <a href={`#${brand.id}`} style={`--c:${brand.color}`} aria-label={brand.name}></a>)}
</nav>
<Fragment slot="scripts">
<script is:inline src="/js/brands.js"></script>
</Fragment>
</Layout>
