---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home – FutureMedia" bodyClass="home" preload="/assets/homepage/homepage.jpg">
<section class="landing" style="background-image:linear-gradient(90deg,rgba(10,21,80,.62),rgba(10,21,80,.34) 46%,rgba(10,21,80,.1)),linear-gradient(180deg,rgba(10,21,80,.34),transparent 18%,transparent 78%,rgba(10,21,80,.24)),url('/assets/homepage/homepage.jpg')">
<section class="hero">
<div class="hero-copy">
<h1><span class="eyebrow">The Future of</span><span class="display">Namibian</span><span class="display accent">Media.</span></h1>
</div>
<div class="panel" id="offers" data-offers='[["99FM Offer","Drive-time packages on Namibia\u2019s boldest station.","/brands.html#99fm","/assets/Brandlogos/99fm.webp","contain"],["Conference Offer","Sponsor Future of Business and meet the room.","/conferences.html","/assets/conference/slide1.webp","cover"],["Newsletter Offer","Weekly media notes, straight to your inbox.","/news.html","/assets/news/news01.webp","cover"],["Media Audit","A free read on where your brand should be.","/media-audit.html","/assets/landingpage_image.webp","cover"]]'><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
</section>
