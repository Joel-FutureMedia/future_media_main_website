---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home – FutureMedia" bodyClass="home" preload="/assets/homepage/homepage.jpg">
<section class="landing" style="background-image:linear-gradient(90deg,rgba(10,21,80,.62),rgba(10,21,80,.34) 46%,rgba(10,21,80,.1)),linear-gradient(180deg,rgba(10,21,80,.34),transparent 18%,transparent 78%,rgba(10,21,80,.24)),url('/assets/homepage/homepage.jpg')">
<section class="hero">
<div class="hero-copy">
<h1><span class="eyebrow">The Future of</span><span class="display">Namibian</span><span class="display accent">Media.</span></h1>
</div>
<div class="panel" id="offers" data-offers='[["99FM Offer","Drive-time packages on Namibia\u2019s boldest station.","/brands.html#99fm","/assets/Brandlogos/99fm.webp","contain"],["Conference Offer","Sponsor Future of Business and meet the room.","/conferences.html","/assets/conference/slide1.webp","cover"],["Newsletter Offer","Weekly media notes, straight to your inbox.","/news.html","/assets/news/news01.webp","cover"],["Media Audit","A free read on where your brand should be.","/contact.html","/assets/landingpage_image.webp","cover"]]'><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
</section>
<div class="strip" aria-label="Our brands">
<div class="marquee"><div class="track">
<div class="group">
<img decoding="async" src="/assets/Logos/fm_web_scroll_99.png" alt="99FM">
<img decoding="async" src="/assets/Logos/fm_web_scroll_fresh.png" alt="Fresh FM">
<img decoding="async" src="/assets/Logos/fm_web_scroll_loo.png" alt="Learn on One">
<img decoding="async" src="/assets/Logos/fm_web_scroll_fmnews.png" alt="FM News">
<img decoding="async" src="/assets/Logos/fm_web_scroll_nov.png" alt="Nova FM">
<img decoding="async" src="/assets/Logos/fm_web_scroll_omulunga.png" alt="Omulunga">
<img decoding="async" src="/assets/Logos/fm_web_scroll_one.png" alt="One Africa">
<img decoding="async" src="/assets/Logos/fm_web_scroll_wave.png" alt="Radio Wave">
<img decoding="async" src="/assets/Logos/fm_web_scroll_specials.png" alt="Specials">
<img decoding="async" src="/assets/Logos/fm_web_scroll_entryfy.png" alt="Entryfy">
<img decoding="async" src="/assets/Logos/fm_web_scroll_promo.png" alt="Promo">
<img decoding="async" src="/assets/Logos/fm_web_scroll_propnews.png" alt="Property News">
<img decoding="async" src="/assets/Logos/fm_web_scroll_shopbeat.png" alt="Shopbeat">
</div>
<div class="group" aria-hidden="true">
<img decoding="async" src="/assets/Logos/fm_web_scroll_99.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_fresh.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_loo.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_fmnews.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_nov.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_omulunga.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_one.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_wave.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_specials.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_entryfy.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_promo.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_propnews.png" alt="">
<img decoding="async" src="/assets/Logos/fm_web_scroll_shopbeat.png" alt="">
</div>
</div></div>
</div>
</section>
<section class="wrap"><div class="cards"><a class="card" href="/news.html" data-bg="url(/assets/news/news01.webp)"><span class="tag">News</span><h3>Future of Business 2026 sells out its first day</h3><p>Nedbank Future of Business returns with record sponsor interest.</p></a><a class="card" href="/news.html" data-bg="url(/assets/news/news02.webp)"><span class="tag">News</span><h3>99FM takes the Conversation Café on the road</h3><p>Live broadcasts, giveaways and street interviews across Windhoek.</p></a><a class="card" href="/news.html" data-bg="url(/assets/news/news03.webp)"><span class="tag">News</span><h3>Fresh FM and Omulunga campaigns draw the crowds</h3><p>Brand activations connect advertisers to northern Namibia.</p></a></div></section>
<section class="best"><img src="/assets/best.webp" alt="Best in Namibia" width="2000" height="256" decoding="async" loading="lazy"></section>
</Layout>
