---
import Layout from '../layouts/Layout.astro';
const logosRoot = "/assets/Logos";
const copy = "99FM engages with a dynamic audience of over 256,000 people, driven by aspirations for economic, social, and personal advancement. We cater to their daily needs with uplifting content and a vibrant mix of Hip-Hop, Afro, and RnB music, fostering an environment of positivity and empowerment. Our platform serves as a beacon for individuals seeking inspiration and motivation to pursue their goals, contributing to the collective growth of our community.";
const logos = [
  [`${logosRoot}/fm_web_scroll_specials.png`, "specials.na"],
  [`${logosRoot}/fm_web_scroll_shopbeat.png`, "Shop Beat"],
  [`${logosRoot}/fm_web_scroll_entryfy.png`, "Entryfy"],
  [`${logosRoot}/fm_web_scroll_propnews.png`, "Property News"],
  [`${logosRoot}/fm_web_scroll_promo.png`, "PromoBasket"]
];
const offer = (logo, href = "/contact.html") => [
  ["Talk to sales", "Plan a campaign with the FutureMedia team.", href, logo, "contain"],
  ["Free media audit", "A clear read on where your brand should be.", "/media-audit.html", logo, "contain"],
  ["Book a demo", "See how Shopbeat can change the room.", "/shopbeat.html", logo, "contain"]
];
const brands = [
  {
    id: "specials", color: "#7A2D86", panel: "#8F9C4A", name: "specials.na",
    logo: `${logosRoot}/fm_web_scroll_specials.png`,
    person: "/assets/Digital/7_Specials/FM_Brands_Specials_Hero.png",
    copy, offers: offer(`${logosRoot}/fm_web_scroll_specials.png`)
  },
  {
    id: "shopbeat", color: "#8A348C", panel: "#7EB8CC", name: "Shop Beat",
    logo: `${logosRoot}/fm_web_scroll_shopbeat.png`,
    person: "/assets/Digital/8_Shop%20Beat/FM_Brands_Shopbeat_Hero.png",
    copy, offers: offer(`${logosRoot}/fm_web_scroll_shopbeat.png`, "/shopbeat.html")
  },
  {
    id: "entryfy", color: "#241548", panel: "#E39B78", name: "Entryfy",
    logo: `${logosRoot}/fm_web_scroll_entryfy.png`,
    person: "/assets/Digital/9_Entryfy/FM_Brands_Entryfy_Hero.png",
    copy, offers: offer(`${logosRoot}/fm_web_scroll_entryfy.png`)
  },
  {
    id: "propertynews", color: "#9C2D58", panel: "#E23B3B", name: "Property News",
    logo: `${logosRoot}/fm_web_scroll_propnews.png`,
    person: "/assets/Digital/10_Property%20News/FM_Brands_PropNews_Hero.png",
    copy, offers: offer(`${logosRoot}/fm_web_scroll_propnews.png`)
  },
  {
    id: "promobasket", color: "#8A2040", panel: "#D42A42", name: "PromoBasket",
    logo: `${logosRoot}/fm_web_scroll_promo.png`,
    person: "/assets/Digital/11_PromoBasket/Gemini_Generated_Image_165gx165gx165gx1.png",
    copy, offers: offer(`${logosRoot}/fm_web_scroll_promo.png`)
  }
];
---
<Layout title="Digital Brands – FutureMedia" bodyClass="brands digital" preload="/assets/Digital/7_Specials/FM_Brands_Specials_Hero.png">
<div class="branddeck" style="--n:6">
<div class="brandstage">
<section class="slide bintro on" id="network">
  <div class="bgimg" style="background-image:url(/assets/landingpage_image.webp)"></div>
  <div class="introcopy">
    <p class="eyebrow">The network</p>
    <h1>Five Digital brands. One powerful network.</h1>
    <p>Scroll to move from one brand to the next. Each platform fills the screen on its own.</p>
  </div>
  <div class="orbit" aria-hidden="true">
    <img class="orbit-core" src="/assets/Broadcast%20Brands/logo-cirlce.png" alt="">
    <div class="orbit-spin" style="--step:72deg">
      {logos.map(([src, name], i) => <span style={`--i:${i}`}><img src={src} alt={name}></span>)}
    </div>
  </div>
</section>

{brands.map(brand => (
<section class="slide brand" id={brand.id} style={`--c:${brand.color};--panel:${brand.panel}`}>
  {brand.person ? <img class="personality" src={brand.person} alt=""> : null}
  <div class="bwrap">
    <div class="bmain">
      <img class="blogo" decoding="async" src={brand.logo} alt={brand.name}>
      <p>{brand.copy}</p>
    </div>
    <div class="panel" data-offers={JSON.stringify(brand.offers)}><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
  </div>
</section>
))}
</div>
</div>
<nav class="rail" aria-label="Digital brands">
  {brands.map(brand => <a href={`#${brand.id}`} style={`--c:${brand.color}`} aria-label={brand.name}></a>)}
</nav>
<Fragment slot="scripts">
<script is:inline src="/js/brands.js"></script>
</Fragment>
</Layout>
