---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us – FutureMedia" fonts="text">
<main class="sub live-page">
  <div class="live-hero">
    <p class="eyebrow">Talk to us</p>
    <h1>Contact Us</h1>
    <p>Tell us who you are and what you need. Sales will follow up with the right brand team.</p>
  </div>
  <div class="contact-grid">
    <div class="info-cards">
      <div class="info-card"><b>Visit</b><span>Unit 44, Hyper Motor City, Maxwell Street, Windhoek</span></div>
      <div class="info-card"><b>Call</b><a href="tel:+264830001000">+264 83 000 1000</a></div>
      <div class="info-card"><b>Email</b><a href="mailto:sales@futuremedia.com.na">sales@futuremedia.com.na</a></div>
      <div class="info-card"><b>Media audit</b><span>Need a channel mix? <a href="/media-audit.html">Start the free audit</a>.</span></div>
    </div>
    <form class="contact-form" id="contactForm">
      <label>Name<input name="name" required></label>
      <label>Email<input name="email" type="email" required></label>
      <label>Telephone<input name="telephone" required></label>
      <label>Company<input name="company" required></label>
      <label>Brand<select name="brandId" required><option value="">Loading…</option></select></label>
      <label>Sales need<select name="salesId" required><option value="">Loading…</option></select></label>
      <label>Service<select name="serviceId" required><option value="">Loading…</option></select></label>
      <button type="submit">Send message</button>
      <p class="note" id="contactNote" hidden></p>
    </form>
  </div>
</main>
</Layout>
